# Copy to backend/.env and fill in. Never commit .env.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: use Redis for the cache (otherwise in-process memory)
# REDIS_URL=redis://localhost:6379/0

# Routing provider: "here" (only one implemented so far)
ROUTING_PROVIDER=here
# HERE Platform API key (Routing v8 + Geocoding & Search v7)
HERE_API_KEY=

# Optional Open-Meteo API key (paid plan). Leave empty to use the free API.
OPEN_METEO_API_KEY=
